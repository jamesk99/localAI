# ============================================================================
# HARDWARE CONFIGURATION (AMD Ryzen AI Max+ 395 / 128GB RAM)
# ============================================================================
USE_ROCM=true
USE_NPU=false
GPU_LAYERS=999
NUM_GPU=1

# Parallel Processing (16 Zen 5 cores)
NUM_WORKERS=8
BATCH_SIZE=32
EMBED_BATCH_SIZE=64

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================
OLLAMA_BASE_URL=http://localhost:11434

# LLM Models - OPTIMIZED FOR 128GB RAM (no quantization needed)
LLM_MODEL=qwen2.5:32b
LLM_FALLBACK=qwen2.5:14b
EMBED_MODEL=bge-m3

# Model Settings
LLM_TEMPERATURE=0.1
LLM_CONTEXT_WINDOW=32768
LLM_REQUEST_TIMEOUT=180.0
LLM_NUM_PREDICT=2048

# Ollama Performance Tuning
OLLAMA_NUM_THREAD=16
OLLAMA_NUM_BATCH=512
OLLAMA_MAIN_GPU=0

# ============================================================================
# RAG CONFIGURATION
# ============================================================================
# Chunking (optimized for 32K context)
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# Retrieval
TOP_K=15
SIMILARITY_THRESHOLD=0.35
MAX_CHUNKS_IN_CONTEXT=20

# Reranking
USE_RERANKING=true
RERANK_TOP_N=8

# ChromaDB Optimization
CHROMA_BATCH_SIZE=5000
CHROMA_PERSIST_INTERVAL=1000

# ============================================================================
# WEB APPLICATION
# ============================================================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ============================================================================
# AUTHENTICATION
# ============================================================================
REQUIRE_AUTH=false
API_KEY=your-secret-key-here

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/rag.log


# ============================================================================
# SYSTEM COMMANDS
# ============================================================================

# Pull the recommended models
ollama pull qwen2.5:32b
ollama pull qwen2.5:14b
ollama pull bge-m3

# Re-ingest with new embedding model
Remove-Item -Recurse -Force .\data\vectordb
Remove-Item -Force .\data\tracking.db
python src\ingest.py